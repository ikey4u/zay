          ".lan",
          ".local",
          ".internal"
        ],
        "server": "dns-direct"
      },
      {
        "action": "route",
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": [
          "gfw",
          "proxy"
        ],
        "server": "dns-direct"
      },
      {
        "action": "route",
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": [
          "geosite-cn",
          "direct",
          "icloud",
          "apple"
        ],
        "server": "dns-direct"
